# Copy to .env.local (never commit real values). All of these are read on the server only.

# Canonical site origin for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.bondsafarikovalam.com

# Booking backend (Node/Express) — see docs/booking-api.md. Leave empty and the booking page shows
# "Online booking isn't connected yet" with WhatsApp / current-booking-page options instead.
BOOKING_API_URL=
BOOKING_API_KEY=

# Razorpay — use rzp_test_… keys on staging. The key id is sent to the browser for Checkout; the secrets never are.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
