# Copy to .env.local (never commit real values). Server-only unless prefixed NEXT_PUBLIC_.

# Canonical site origin for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.bondsafarikovalam.com

# Booking backend (Node/Express) — see docs/booking-api.md. Leave empty and the booking page shows
# "Online booking isn't connected yet" with WhatsApp / current-booking-page options instead.
BOOKING_API_URL=
BOOKING_API_KEY=

# Events API: one URL, a key per company. Keep these server-only; the browser calls /api/events and /api/courses instead.
EVENTS_API_URL=https://logout.world/api/company/events/
# Bond Safari's key: lists the activities.
EVENTS_API_KEY=
# Bond Water Sports Academy's key: lists the courses.
COURSES_API_KEY=
# Optional when API image fields are relative paths (for example, event/3172/cover.jpg).
NEXT_PUBLIC_EVENTS_MEDIA_BASE_URL=https://logout.world/media

# Razorpay — use rzp_test_… keys on staging. The key id is sent to the browser for Checkout; the secrets never are.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# tawk.to live chat — from dashboard.tawk.to → Administration → Channels → Chat Widget:
# https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>. Leave empty and no chat widget loads.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
